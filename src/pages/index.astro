---
import Layout from '../layouts/Layout.astro';
import ProductStudy from '../components/ProductStudy.astro';
import Arrow from '../components/Arrow.astro';
import FeaturedProject from '../components/FeaturedProject.astro';
import ContactCta from '../components/ContactCta.astro';
---
<Layout title="Salim Youssef Najim — Engineering & beyond" class="home-page">
  <section class="landing-hero section-pad" aria-labelledby="landing-title">
    <div class="landing-copy">
      <p class="landing-name">Salim Youssef Najim</p>
      <h1 id="landing-title">Engineering.<br/><span>In perspective.</span></h1>
      <p class="landing-lead">Aerospace Engineering student at Khalifa University. Exploring how technical ideas become useful projects.</p>
      <div class="landing-actions"><a class="button button-light" href="#selected-work">Explore my work <Arrow/></a><a class="button" href="/contact/">Contact me <Arrow diagonal/></a></div>
      <p class="landing-note"><span></span>Aerospace · Energy · Systems</p>
    </div>
    <div class="landing-study"><ProductStudy id="home-propulsion" priority/></div>
  </section>
  <section id="selected-work" class="selected-work" aria-labelledby="selected-title">
    <div class="section-heading section-pad reveal"><div><p class="eyebrow section-index">Selected work</p><h2 id="selected-title">From question to concept.</h2></div><a class="text-link" href="/projects/">All projects <Arrow/></a></div>
    <FeaturedProject/>
  </section>
  <section class="home-profile section-pad" aria-labelledby="profile-title">
    <figure class="portrait-frame reveal"><img src="/images/salim.webp" alt="Salim Youssef Najim" width="826" height="826" loading="lazy" decoding="async"/></figure>
    <div class="home-profile-copy reveal"><p class="eyebrow section-index">A little about me</p><h2 id="profile-title">Curious about<br/>how things work.</h2><p>Engineering is my foundation. Leading LUMOS gave me a way to connect that curiosity with a team and a practical question: how could we approach urban lighting differently?</p><a class="text-link" href="/about/">My background <Arrow/></a>
      <div class="perspective-links"><a href="/aerospace/"><span><strong>Aerospace</strong><small>Flight, energy and connected systems.</small></span><Arrow diagonal/></a><a href="/ventures/"><span><strong>Business perspective</strong><small>Useful ideas and the people they serve.</small></span><Arrow diagonal/></a></div>
    </div>
  </section>
  <ContactCta/>
</Layout>
