---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
---
<Layout title="Contact — Salim Youssef Najim" description="Contact Salim Youssef Najim about engineering projects, business ideas and collaboration.">
  <section class="contact-main section-pad">
    <div class="contact-direct">
      <p class="eyebrow section-index">Contact</p>
      <h1>Let’s talk.</h1>
      <p class="lead">For engineering projects, business ideas and collaboration.</p>
      <a class="contact-address" id="contact-email" href={`mailto:${site.email}`}>{site.email}<Arrow diagonal/></a>
      <div class="contact-actions">
        <a class="button button-light" href={`mailto:${site.email}`}>Open email app <Arrow diagonal/></a>
        <button type="button" class="button" id="copy-email" data-email={site.email} hidden>Copy email</button>
      </div>
      <p class="copy-status" id="copy-status" role="status" aria-live="polite"></p>
      <div class="contact-channels"><a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer">GitHub <Arrow diagonal/></a></div>
    </div>
    <div>
      <details class="contact-compose">
        <summary>Prefer to draft it here?</summary>
        <form method="post" class="contact-form" id="contact-form" data-recipient={site.email} aria-label="Prepare an email" aria-describedby="form-help">
          <p class="form-hint" id="form-help">Add a few details, then open the draft in your email app. You’ll review and send it there.</p>
          <div class="form-field"><label for="name">Your name</label><input id="name" name="name" autocomplete="name" required maxlength="100" placeholder="Your name"/></div>
          <div class="form-field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.com"/></div>
          <div class="form-field"><label for="topic">Topic</label><select id="topic" name="topic"><option>Engineering project</option><option>Business collaboration</option><option>Creative work</option><option>A conversation</option></select></div>
          <div class="form-field"><label for="message">Your message</label><textarea id="message" name="message" required minlength="10" maxlength="4000" placeholder="A little about the idea or project…"></textarea></div>
          <div class="honeypot" aria-hidden="true"><label for="company-site">Leave this field empty</label><input id="company-site" name="company-site" tabindex="-1" autocomplete="off"/></div>
          <button class="button button-light" type="submit" disabled>Prepare email <Arrow/></button>
          <p class="form-status" id="form-status" role="status" aria-live="polite"></p>
          <a id="email-fallback" class="text-link" href={`mailto:${site.email}`} hidden>Open the prepared email <Arrow diagonal/></a>
          <noscript><p class="form-hint">Please use the email address above to get in touch.</p></noscript>
        </form>
      </details>
    </div>
  </section>
  <script>
    const copyButton = document.querySelector<HTMLButtonElement>('#copy-email');
    const copyStatus = document.querySelector<HTMLElement>('#copy-status');
    copyButton?.addEventListener('click', async () => {
      const email = copyButton.dataset.email;
      if (!email || !copyStatus) return;
      copyButton.disabled = true;
      try {
        await navigator.clipboard.writeText(email);
        copyStatus.textContent = 'Email address copied.';
      } catch {
        copyStatus.textContent = 'Copy is unavailable here. Select the address above to copy it, or open your email app.';
      } finally {
        copyButton.disabled = false;
      }
    });
    if (copyButton) copyButton.hidden = false;

    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const status = document.querySelector<HTMLElement>('#form-status');
    const fallback = document.querySelector<HTMLAnchorElement>('#email-fallback');
    const submit = form?.querySelector<HTMLButtonElement>('button[type=submit]');
    const nameInput = form?.querySelector<HTMLInputElement>('#name');
    const messageInput = form?.querySelector<HTMLTextAreaElement>('#message');

    const updateDraft = () => {
      nameInput?.setCustomValidity('');
      messageInput?.setCustomValidity('');
      if (!fallback || fallback.hidden) return;
      fallback.hidden = true;
      fallback.href = `mailto:${form?.dataset.recipient}`;
      if (status) {
        status.dataset.error = 'false';
        status.textContent = 'Your message has changed. Prepare the email again to include your latest changes.';
      }
    };
    form?.addEventListener('input', updateDraft);
    form?.addEventListener('change', updateDraft);
    form?.addEventListener('submit', event => {
      event.preventDefault();
      if (!status || !fallback || !nameInput || !messageInput) return;
      const data = new FormData(form);
      if (data.get('company-site')) return;
      const name = nameInput.value.trim();
      const message = messageInput.value.trim();
      nameInput.setCustomValidity(name ? '' : 'Please enter your name.');
      messageInput.setCustomValidity(message.length >= 10 ? '' : 'Please add at least 10 characters about your idea.');
      if (!form.reportValidity()) {
        status.textContent = 'Please complete the highlighted field before preparing your email.';
        status.dataset.error = 'true';
        return;
      }
      const body = `${message}\n\nFrom: ${name}\nReply to: ${data.get('email')}`;
      const uri = `mailto:${form.dataset.recipient}?subject=${encodeURIComponent(`${data.get('topic')} — ${name}`)}&body=${encodeURIComponent(body)}`;
      fallback.href = uri;
      fallback.hidden = false;
      status.dataset.error = 'false';
      status.textContent = 'Your draft is ready. Open it below, then review and send it from your email app.';
      fallback.focus();
    });
    if (submit) submit.disabled = false;
  </script>
</Layout>
