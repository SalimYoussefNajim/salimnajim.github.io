---
import Layout from '../layouts/Layout.astro';
import Arrow from '../components/Arrow.astro';
import { site } from '../data/site';
---
<Layout title="Get in Touch — Salim Youssef Najim" description="Contact Salim Youssef Najim about engineering projects, collaborations and ideas worth building.">
  <section class="contact-main section-pad"><div><p class="eyebrow section-index">Contact / Begin a conversation</p><h1>What could<br/>we <span class="muted">build?</span></h1><p class="lead">A project, a collaboration or a question worth exploring. I’d like to hear it.</p><a class="contact-address" href={`mailto:${site.email}`}>{site.email}<Arrow diagonal/></a><div class="contact-channels"><a class="text-link" href={site.github} target="_blank" rel="noopener noreferrer">GitHub <Arrow diagonal/></a><p class="eyebrow">Engineering<br/>Entrepreneurship<br/>New perspectives</p></div></div><form method="post" class="contact-form" id="contact-form" data-recipient={site.email}><div class="form-field"><label for="name">01 / Your name</label><input id="name" name="name" autocomplete="name" required maxlength="100" placeholder="How should I address you?"/></div><div class="form-field"><label for="email">02 / Email address</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="254" placeholder="you@example.com"/></div><div class="form-field"><label for="topic">03 / What’s on your mind?</label><select id="topic" name="topic"><option>Engineering project</option><option>Business collaboration</option><option>Creative work</option><option>A conversation</option></select></div><div class="form-field"><label for="message">04 / A little about the idea</label><textarea id="message" name="message" required minlength="10" maxlength="4000" placeholder="The idea, the context, the possibility…"></textarea></div><div class="honeypot" aria-hidden="true"><label for="company-site">Leave this field empty</label><input id="company-site" name="company-site" tabindex="-1" autocomplete="off"/></div><p class="form-hint">This prepares an email in your email app. You review and send it there. Your message is not stored on this website.</p><button class="button button-light" type="submit" disabled>Prepare email <Arrow/></button><p class="form-status" id="form-status" role="status" aria-live="polite"></p><a id="email-fallback" class="text-link" href={`mailto:${site.email}`} hidden>Open the prepared email <Arrow/></a><noscript><p class="form-hint">Please use the email address above to get in touch.</p></noscript></form></section>
  <script>
    const form = document.querySelector<HTMLFormElement>('#contact-form');
    const status = document.querySelector<HTMLElement>('#form-status');
    const fallback = document.querySelector<HTMLAnchorElement>('#email-fallback');
    const submit = form?.querySelector<HTMLButtonElement>('button[type=submit]');
    const nameInput = form?.querySelector<HTMLInputElement>('#name');
    const messageInput = form?.querySelector<HTMLTextAreaElement>('#message');

    const updateDraft = () => {
      nameInput?.setCustomValidity('');
      messageInput?.setCustomValidity('');
      if (!fallback || fallback.hidden) return;
      fallback.hidden = true;
      fallback.href = `mailto:${form?.dataset.recipient}`;
      if (status) {
        status.dataset.error = 'false';
        status.textContent = 'Your message has changed. Prepare the email again to include your latest changes.';
      }
    };
    form?.addEventListener('input', updateDraft);
    form?.addEventListener('change', updateDraft);
    form?.addEventListener('submit', event => {
      event.preventDefault();
      if (!status || !fallback || !nameInput || !messageInput) return;
      const data = new FormData(form);
      if (data.get('company-site')) return;
      const name = nameInput.value.trim();
      const message = messageInput.value.trim();
      nameInput.setCustomValidity(name ? '' : 'Please enter your name.');
      messageInput.setCustomValidity(message.length >= 10 ? '' : 'Please add at least 10 characters about your idea.');
      if (!form.reportValidity()) {
        status.textContent = 'Please complete the highlighted field before preparing your email.';
        status.dataset.error = 'true';
        return;
      }
      const body = `${message}\n\nFrom: ${name}\nReply to: ${data.get('email')}`;
      const uri = `mailto:${form.dataset.recipient}?subject=${encodeURIComponent(`${data.get('topic')} — ${name}`)}&body=${encodeURIComponent(body)}`;
      fallback.href = uri; fallback.hidden=false;
      status.dataset.error='false';
      status.textContent='Your email draft is ready. Open it using the link below, then review and send it from your email app.';
      fallback.focus();
    });
    if (submit) submit.disabled = false;
  </script>
</Layout>
