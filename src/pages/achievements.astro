---
import Layout from '../layouts/Layout.astro';
import { milestones } from '../data/site';
import ContactCta from '../components/ContactCta.astro';
import Arrow from '../components/Arrow.astro';
const links: Record<string, { href: string; label: string }> = {
  'Aerospace Engineering': { href: '/aerospace/', label: 'Explore aerospace' },
  'Leading LUMOS': { href: '/projects/lumos/', label: 'Read the LUMOS case study' }
};
---
<Layout title="Education & Experience — Salim Youssef Najim" description="Aerospace Engineering at Khalifa University and team leadership on the LUMOS student engineering project by Salim Youssef Najim.">
  <section class="page-hero section-pad"><p class="eyebrow section-index">Selected milestones</p><h1>Education &<br/><span>experience.</span></h1><p class="lead">Aerospace studies at Khalifa University, alongside team leadership on the LUMOS student project.</p></section>
  <section class="milestones section-pad" aria-label="Education and project experience">
    {milestones.map((item,i)=><article class="milestone reveal"><span class="milestone-index" aria-hidden="true">0{i+1}</span><div><p class="eyebrow">{item.category}</p><h2>{item.title}</h2><p>{item.context}</p></div><div><p>{item.detail}</p>{links[item.title] && <a class="text-link" href={links[item.title].href}>{links[item.title].label} <Arrow/></a>}</div></article>)}
  </section>
  <ContactCta/>
</Layout>
