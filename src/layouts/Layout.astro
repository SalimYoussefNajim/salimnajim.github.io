---
import '../styles/global.css';
import { site, navigation } from '../data/site';
import Mark from '../components/Mark.astro';
import Arrow from '../components/Arrow.astro';
interface Props { title: string; description?: string; noindex?: boolean; class?: string; schema?: Record<string, unknown>; }
const { title, description = site.description, noindex = false, class: pageClass = '', schema } = Astro.props;
const canonical = new URL(noindex ? '/404.html' : Astro.url.pathname, site.url).href;
const graph = [{ '@type': 'Person', '@id': `${site.url}/#person`, name: site.name, url: site.url, ...(site.email ? { email: site.email } : {}), sameAs: [site.github] }, { '@type': 'WebSite', '@id': `${site.url}/#website`, name: site.name, url: site.url, author: { '@id': `${site.url}/#person` } }, ...(schema ? [schema] : [])];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <meta name="theme-color" content="#0b0e11"/>
    <title>{title}</title><meta name="description" content={description}/>
    <link rel="canonical" href={canonical}/>
    {noindex && <meta name="robots" content="noindex,follow"/>}
    <meta property="og:type" content="website"/><meta property="og:site_name" content={site.name}/>
    <meta property="og:title" content={title}/><meta property="og:description" content={description}/>
    <meta property="og:url" content={canonical}/><meta property="og:image" content={`${site.url}/images/social-preview.png`}/>
    <meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content="Salim Youssef Najim — Ideas into flight. Aerospace, entrepreneurship and projects."/>
    <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/><meta name="twitter:image" content={`${site.url}/images/social-preview.png`}/>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png"/>
    <link rel="manifest" href="/site.webmanifest"/>
    <link rel="preload" href="/fonts/manrope-latin.woff2" as="font" type="font/woff2" crossorigin/>
    <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c')}/>
  </head>
  <body class={pageClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Salim Youssef Najim — Home"><Mark/><span>Salim Najim<span class="brand-sub">Engineering & beyond</span></span></a>
      <nav class="desktop-nav" aria-label="Main navigation">{navigation.map(item => <a href={item.href} aria-current={Astro.url.pathname.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>)}</nav>
      <a class="nav-contact" href="/contact/">Get in touch <Arrow diagonal/></a>
      <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false" aria-controls="mobile-menu"><span>Menu</span><span class="menu-lines"><i></i><i></i></span></button>
    </header>
    <dialog id="mobile-menu" class="mobile-menu" aria-label="Site navigation">
      <div class="menu-top"><a class="brand" href="/"><Mark/>Salim Najim</a><button class="menu-close" aria-label="Close navigation">Close <span>×</span></button></div>
      <nav aria-label="Mobile navigation">{[{label:'Home',href:'/'}, ...navigation, {label:'Contact',href:'/contact/'}].map((item,i) => <a href={item.href} style={`--menu-order:${i}`} aria-current={(item.href === '/' ? Astro.url.pathname === '/' : Astro.url.pathname.startsWith(item.href)) ? 'page' : undefined}><span class="eyebrow">0{i+1}</span>{item.label}<Arrow diagonal/></a>)}</nav>
      <p class="menu-foot">Aerospace Engineering · Entrepreneurship · Projects</p>
    </dialog>
    <main id="main" tabindex="-1"><slot/></main>
    <footer class="site-footer section-pad">
      <div class="footer-top"><a class="brand" href="/"><Mark/>Salim Youssef Najim</a><p>Aerospace Engineering.<br/>A business perspective.<br/>Always building.</p><nav aria-label="Footer navigation">{navigation.map(item=><a href={item.href}>{item.label}</a>)}<a href="/contact/">Contact</a></nav><div class="footer-social"><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub <Arrow diagonal/></a>{site.email && <a href={`mailto:${site.email}`}>Email <Arrow diagonal/></a>}<a href="#main">Back to top ↑</a></div></div>
      <div class="footer-name" aria-hidden="true">SALIM NAJIM<span>↗</span></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Salim Youssef Najim</span><span>Ideas into flight.</span><span>Engineering / Business / Beyond</span></div>
    </footer>
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
