  <g stroke="#334747" stroke-width=".6"><path d="m60 350 315-85 255 67-315 99Z"/><path d="m90 378 315-88m-205 114 315-89M140 328l251 67m-148-95 251 67"/><path d="M350 58v352" stroke-dasharray="3 7"/></g>
