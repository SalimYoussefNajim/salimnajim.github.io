<figure class="kinetic-study" data-kinetic-study data-kinetic-active="0">
  <div class="kinetic-study__frame" data-kinetic-frame>
    <img class="kinetic-study__image" data-kinetic-image src="/images/kinetic/poster-640.webp" srcset="/images/kinetic/poster-480.webp 480w, /images/kinetic/poster-640.webp 640w, /images/kinetic/frame-00.webp 900w" sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1100px) 55vw, 680px" width="900" height="900" fetchpriority="high" decoding="async" alt="An original kinetic sculpture of nested metallic rings, shown as a dimensional study of form and movement." draggable="false"/>
  </div>
  <div class="kinetic-study__controls" data-kinetic-controls hidden>
    <span aria-hidden="true">01</span>
    <input class="kinetic-study__range" data-kinetic-range type="range" min="0" max="35" step="1" value="0" aria-label="Rotate the sculpture" aria-valuetext="View 1 of 36"/>
    <span aria-hidden="true">36</span>
  </div>
  <figcaption class="kinetic-study__caption"><span>Kinetic study</span><span>Form in motion</span></figcaption>
  <span class="kinetic-study__status" data-kinetic-status role="status" aria-live="polite" aria-atomic="true"></span>
</figure>

<script>
  import { mountKineticStudy } from '../scripts/kinetic-study';
  const studies = new Map<HTMLElement, () => void>();
  const initialize = () => {
    document.querySelectorAll<HTMLElement>('[data-kinetic-study]').forEach((host) => {
      if (!studies.has(host)) studies.set(host, mountKineticStudy(host));
    });
  };
  initialize();
  window.addEventListener('pagehide', () => {
    studies.forEach((dispose) => dispose());
    studies.clear();
  });
  window.addEventListener('pageshow', (event) => { if (event.persisted) initialize(); });
</script>

<style>
  .kinetic-study{position:relative;width:100%;min-width:0;margin:0;color:#262823}
  .kinetic-study__frame{position:relative;width:100%;aspect-ratio:1;touch-action:pan-y;cursor:grab;isolation:isolate}
  .kinetic-study__frame[data-dragging=true]{cursor:grabbing}
  .kinetic-study__frame :global(.kinetic-study__image){position:absolute;inset:0;display:block;width:100%;height:100%;object-fit:contain;user-select:none;pointer-events:none}
  .kinetic-study__controls{display:flex;align-items:center;gap:14px;max-width:260px;margin:-4px auto 0;font:10px/1.4 var(--mono,monospace);letter-spacing:.08em}
  .kinetic-study__controls[hidden]{display:none}
  .kinetic-study__range{display:block;width:100%;min-width:0;height:44px;margin:0;padding:0;background:transparent;accent-color:#282b24;cursor:ew-resize}
  .kinetic-study__range:focus-visible{outline:2px solid currentColor;outline-offset:3px;border-radius:2px}
  .kinetic-study__caption{display:flex;justify-content:center;flex-wrap:wrap;gap:10px;margin:0;padding:0 10px;font:10px/1.5 var(--mono,monospace);letter-spacing:.025em;color:#62665d}
  .kinetic-study__caption span+span:before{content:'/';margin-right:10px;color:#85897f}
  .kinetic-study__status{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
  .kinetic-study__status[data-error=true]{position:static;display:block;width:auto;height:auto;margin:10px auto 0;max-width:32em;padding:0 12px;overflow:visible;clip:auto;white-space:normal;text-align:center;font-size:12px;line-height:1.5;color:#62665d}
  @media(max-width:700px){.kinetic-study__controls{max-width:220px}.kinetic-study__caption{font-size:9px}}
</style>
