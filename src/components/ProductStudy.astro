---
interface Props {
  id?: string;
  priority?: boolean;
}
const { id = 'propulsion', priority = false } = Astro.props;
const sizes = '(max-width: 800px) calc(100vw - 40px), 55vw';
const views = ['Assembled', 'Exploded', 'Cutaway'];
---

<figure class="product-study" id={id} data-product-study data-product-active="0">
  <div class="product-study__frame" data-product-frame>
    <picture class="product-study__image is-active" data-product-layer="0">
      <img
        src="/images/propulsion-assembled-1280.webp"
        srcset="/images/propulsion-assembled-640.webp 640w, /images/propulsion-assembled-1280.webp 1280w"
        sizes={sizes}
        width="1280"
        height="853"
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        decoding="async"
        alt="Studio rendering of an assembled propulsion concept, with a silver fan and layered engine housing."
      />
    </picture>
    <span class="product-study__view-label" data-product-view-label aria-hidden="true">01 / Assembled</span>
  </div>
  <div class="product-study__toolbar" role="group" aria-label="Propulsion study views">
    {views.map((view, index) => <button type="button" data-product-view={index} aria-pressed={index === 0 ? 'true' : 'false'} disabled>{view}</button>)}
  </div>
  <figcaption class="product-study__caption">Propulsion study<span aria-hidden="true"> · </span><span>Concept visualization</span></figcaption>
  <span class="product-study__status" data-product-status role="status" aria-live="polite" aria-atomic="true"></span>
</figure>

<script>
  import { mountProductStudy } from '../scripts/product-study';

  const studies = new Map<HTMLElement, () => void>();
  const initialize = () => {
    document.querySelectorAll<HTMLElement>('[data-product-study]').forEach((host) => {
      if (!studies.has(host)) studies.set(host, mountProductStudy(host));
    });
  };
  initialize();
  window.addEventListener('pagehide', () => {
    studies.forEach((dispose) => dispose());
    studies.clear();
  });
  window.addEventListener('pageshow', (event) => { if (event.persisted) initialize(); });
</script>

<style>
    .product-study{position:relative;width:100%;min-width:0;margin:0;isolation:isolate}
    .product-study__frame{position:relative;width:100%;aspect-ratio:3/2;overflow:hidden;border-radius:20px;background:radial-gradient(ellipse at 50% 53%,#27323d75,transparent 65%);touch-action:auto}
    .product-study__frame :global(.product-study__image){position:absolute;inset:0;display:block;opacity:0;transition:opacity .25s ease;pointer-events:none}
    .product-study__frame :global(.product-study__image.is-active){opacity:1}
    .product-study__frame :global(img){display:block;width:100%;height:100%;object-fit:contain;pointer-events:none;user-select:none}
    .product-study__view-label{position:absolute;left:20px;bottom:16px;color:#a8b2bf;font:10px var(--mono,monospace);letter-spacing:.06em;line-height:1.5;pointer-events:none}
    .product-study__toolbar{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:5px;max-width:380px;margin:16px auto 0;padding:4px;border:1px solid #b6c1ce24;border-radius:12px;background:#171d24}
    .product-study__toolbar button{display:flex;align-items:center;justify-content:center;min-width:0;min-height:44px;padding:10px 12px;border:1px solid transparent;border-radius:8px;background:transparent;color:#aeb7c2;font:inherit;font-size:13px;font-weight:500;line-height:1.3;letter-spacing:0;cursor:pointer;touch-action:manipulation;transition:background .2s,color .2s,border-color .2s}
    .product-study__toolbar button:hover{color:#f4f6f8;background:#ffffff08}
    .product-study__toolbar button[aria-pressed=true]{color:#f7f8fa;border-color:#bdcbd52c;background:#303b47;box-shadow:0 2px 7px #0002}
    .product-study__toolbar button[aria-busy=true]{color:#d8e0e8}
    .product-study__toolbar button:focus-visible{outline:2px solid #bfd8ec;outline-offset:3px}
    .product-study__toolbar button:disabled{cursor:default;opacity:.55}
    .product-study__caption{display:flex;justify-content:center;gap:6px;flex-wrap:wrap;margin-top:14px;color:#8f9aa7;font-size:11px;line-height:1.6;text-align:center}
    .product-study__status{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
    .product-study__status[data-error=true]{position:static;display:block;width:auto;height:auto;margin:12px 0 0;overflow:visible;clip:auto;white-space:normal;text-align:center;font-size:12px;line-height:1.5;color:#c7c1ba}
    @media(max-width:700px){.product-study__frame{aspect-ratio:4/3;border-radius:14px}.product-study__view-label{left:12px;bottom:10px;font-size:9px}.product-study__toolbar{margin-top:12px;max-width:340px}.product-study__toolbar button{padding:10px 8px;font-size:12px}.product-study__caption{font-size:10px;margin-top:12px}}
    @media(prefers-reduced-motion:reduce){.product-study__frame :global(.product-study__image),.product-study__toolbar button{transition:none}}
</style>
