---
import Arrow from './Arrow.astro';
---
<section class="books-feature section-pad" id="books" aria-labelledby="books-feature-title">
  <div class="books-feature-heading reveal"><p class="eyebrow section-index">02 / On paper</p><h2 id="books-feature-title">Another way<br/>to <em>explore.</em></h2><a class="text-link" href="/books/">The complete library <Arrow diagonal/></a></div>
  <a class="featured-book-stage" href="/books/#built-from-physics" aria-label="Explore Built from Physics">
    <div class="book-orbit" aria-hidden="true"></div><span class="book-stage-index eyebrow" aria-hidden="true">Physics / Engineering / Curiosity</span>
    <div class="featured-book"><div class="featured-book-pages"></div><div class="featured-book-spine" aria-hidden="true"><span>BUILT FROM PHYSICS</span></div><img src="/images/books/physics-feature.webp" alt="The original cover of Built from Physics by Salim Youssef Najim" width="720" height="1080" loading="lazy" decoding="async"/></div>
    <span class="book-stage-caption eyebrow">A book by Salim Youssef Najim <Arrow diagonal/></span>
  </a>
  <div class="books-feature-copy reveal"><p class="eyebrow">Featured book / 2026</p><h3>Built from<br/> Physics.</h3><p class="book-subtitle">How Humanity Shapes Matter, Harnesses Energy, and Engineers the Future</p><p>From the forces we feel to the systems we build. A journey through the physics behind materials, energy, technology and spaceflight.</p><div class="feature-book-links"><a class="text-link" href="/books/#built-from-physics">Inside the book <Arrow/></a><a class="text-link" href="https://www.amazon.com/dp/B0HHGF1DYJ" target="_blank" rel="noopener noreferrer">View on Amazon <Arrow diagonal/></a></div></div>
  <div class="books-feature-bottom"><p>Also on the shelf</p><a href="/books/#ai-books">Talk to AI Like a Pro <span>Explore the series <Arrow/></span></a><a href="/books/#more-books">The Creator Code & The Startup Idea Lab Planner <Arrow diagonal/></a></div>
</section>
<style>
.books-feature{padding-top:88px;padding-bottom:55px;background:#e5e1d6;display:grid;grid-template-columns:1.15fr 1fr;column-gap:9%;position:relative;overflow:clip}.books-feature-heading{grid-column:1/-1;display:grid;grid-template-columns:1fr auto;align-items:end}.books-feature-heading>.eyebrow{grid-column:1/-1;margin-bottom:23px}.books-feature-heading h2{font-size:clamp(43px,6vw,88px)}.featured-book-stage{position:relative;min-height:600px;display:grid;place-items:center;perspective:1300px;margin-top:35px;isolation:isolate}.featured-book-stage:after{content:'';position:absolute;bottom:12%;width:52%;height:6%;border-radius:50%;background:#242c2855;filter:blur(24px);transform:rotate(-15deg);z-index:-1}.book-orbit{position:absolute;width:96%;aspect-ratio:1;border:1px solid #20221f22;border-radius:50%;transform:rotateX(65deg) rotateZ(-20deg);pointer-events:none}.featured-book{width:min(54%,280px);aspect-ratio:2/3;position:relative;transform-style:preserve-3d;transform:rotateX(9deg) rotateY(-26deg) rotateZ(-9deg);transition:transform .75s cubic-bezier(.2,.7,.2,1)}.featured-book-stage:hover .featured-book,.featured-book-stage:focus-visible .featured-book{transform:rotateX(4deg) rotateY(-12deg) rotateZ(-3deg)}.featured-book img{position:absolute;width:100%;height:100%;object-fit:fill;transform:translateZ(19px);box-shadow:inset 5px 0 10px #0005;border-radius:1px 4px 4px 1px}.featured-book-pages{position:absolute;inset:3px 0 3px 2px;transform:translateZ(-1px);background:repeating-linear-gradient(to right,#d6d2c6 0 1px,#f9f6ec 1px 3px);box-shadow:3px 3px 0 #151c23;height:calc(100% - 6px);width:100%}.featured-book-pages:after{content:'';position:absolute;right:-17px;top:0;height:100%;width:36px;background:repeating-linear-gradient(90deg,#c7c3b8 0 1px,#f0eee3 1px 3px);transform:rotateY(90deg)}.featured-book-spine{position:absolute;left:-19px;top:0;width:38px;height:100%;background:#142331;transform:rotateY(-90deg);color:#e8ddb8;display:flex;align-items:center;justify-content:center}.featured-book-spine span{writing-mode:vertical-rl;font:12px Georgia,serif;letter-spacing:.12em}.book-stage-index{position:absolute;top:14px;left:0;font-size:8px}.book-stage-caption{position:absolute;bottom:30px;left:0;right:0;display:flex;justify-content:center;align-items:center;gap:24px;font-size:8px}.book-stage-caption svg{width:16px}.books-feature-copy{align-self:center;padding:50px 0}.books-feature-copy h3{font-size:clamp(49px,5.8vw,87px);margin:25px 0}.books-feature-copy>p{max-width:430px;font-size:15px}.books-feature-copy .book-subtitle{font-family:Georgia,serif;font-size:22px;line-height:1.35;color:#33372d;margin-bottom:24px}.feature-book-links{display:flex;flex-wrap:wrap;gap:10px 24px;margin-top:26px}.feature-book-links .text-link{font-size:12px;gap:12px}.books-feature-bottom{grid-column:1/-1;display:grid;grid-template-columns:.7fr 1.2fr 1.3fr;align-items:center;gap:25px;padding-top:28px;border-top:1px solid #20221f30}.books-feature-bottom>p{font:10px var(--mono);text-transform:uppercase}.books-feature-bottom a{font-size:14px;line-height:1.5;min-height:44px;display:flex;align-items:center;gap:20px}.books-feature-bottom a>span{font:9px var(--mono);display:flex;gap:12px;align-items:center}.books-feature-bottom svg{width:17px;flex-shrink:0}.books-feature-bottom a:hover{text-decoration:underline;text-underline-offset:5px}
@media(max-width:900px){.books-feature{column-gap:5%}.featured-book-stage{min-height:490px}.featured-book{width:60%}.books-feature-bottom{grid-template-columns:.6fr 1fr}.books-feature-bottom>a:last-child{grid-column:2}.books-feature-bottom a>span{display:none}}
@media(max-width:600px){.books-feature{padding-top:52px;padding-bottom:35px;grid-template-columns:1fr}.books-feature-heading{gap:15px}.books-feature-heading h2{font-size:43px}.books-feature-heading>.text-link{font-size:11px;gap:10px;max-width:125px;line-height:1.5}.featured-book-stage{min-height:450px;margin-top:28px}.featured-book{width:49%;max-width:210px}.book-stage-index{font-size:7px}.books-feature-copy{padding:12px 0 32px}.books-feature-copy h3{font-size:52px;margin:20px 0}.books-feature-copy h3 br{display:none}.books-feature-copy .book-subtitle{font-size:21px}.books-feature-copy>p{font-size:15px}.books-feature-bottom{grid-template-columns:1fr;gap:13px}.books-feature-bottom>a:last-child{grid-column:1}.books-feature-bottom a{font-size:13px;justify-content:space-between}.books-feature-bottom a>span{display:flex}.book-stage-caption{bottom:20px;font-size:7px}}
@media(prefers-reduced-motion:reduce){.featured-book{transition:none}}
</style>
